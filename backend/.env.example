# Backend environment variables (all optional for local development).
# Set these in your shell or hosting provider; Django reads them via os.environ.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Leave DB_ENGINE unset to use SQLite (backend/db.sqlite3).
# DB_ENGINE=postgres
# DB_NAME=yatra_db
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=5432

# Leave empty to print emails to the console instead of sending them.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

GOOGLE_CLIENT_ID=1056481750509-tamjc8high1hpu06vcjs3c806o1st2cv.apps.googleusercontent.com
