# Backend environment variables. On Render these are set in the dashboard
# (see render.yaml). Locally they are all optional: without them the app uses
# SQLite, saves uploads to backend/media/ and prints emails to the console.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Only needed for the Django admin over HTTPS on a custom domain:
# CSRF_TRUSTED_ORIGINS=https://api.example.com

# Database: Supabase pooler connection string (Session pooler, port 5432).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Storage (S3 access keys from Project Settings -> Storage -> S3 Connection)
# SUPABASE_PROJECT_REF=abcdefghijklmnop
# SUPABASE_S3_REGION=ap-south-1
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
# SUPABASE_STORAGE_BUCKET=media

# Leave empty to print emails to the console instead of sending them.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

GOOGLE_CLIENT_ID=510753548896-l1vfu7jo2sjq43o0o3vqk83ned0hpopk.apps.googleusercontent.com
